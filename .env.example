# Copy this file to .env and set values for production
# OPENROUTER_API_KEY should be set to your OpenRouter API key
OPENROUTER_API_KEY=

# MongoDB connection string
MONGODB_URI=

# Flask secret key
FLASK_SECRET_KEY=change_this_secret

# Optional Google Search Console HTML meta-tag verification token
GOOGLE_SITE_VERIFICATION=

# Redis URL (optional)
# REDIS_URL=redis://localhost:6379/0
